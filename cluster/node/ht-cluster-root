# ----- The cluster's own jobs as root (modules/jobs.py's "Any command or script"; the user, 2026-11-24: root only
# with the cluster password, one set once in the app). Each computer keeps only a salted check of it, readable by
# root alone; the password itself only ever comes on stdin, never in a command's words, and is never written down.
PASSWORD_FILE = os.path.join(INSTALL, "cluster-password.json") if WINDOWS else at("/var/lib/ht-cluster/cluster-password.json")
PASSWORD_ROUNDS = 200000


def stdin_json():
    try:
        d = json.loads(sys.stdin.readline() or "{}")
    except ValueError:
        d = None
    if not isinstance(d, dict):
        raise Failed("Not JSON on stdin.")
    return d


def password_right(password):
    """True or False, or None when no cluster password is set here."""
    try:
        with open(PASSWORD_FILE, "r", encoding="utf-8") as f:
            s = json.load(f)
        want = bytes.fromhex(s["hash"])
        got = hashlib.pbkdf2_hmac("sha256", str(password).encode("utf-8"), bytes.fromhex(s["salt"]), int(s.get("rounds") or PASSWORD_ROUNDS))
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return hmac.compare_digest(got, want)


def cluster_password():
    """{"check": password} -> {"set", "right"}; or {"new", "old" (the one set before, if there is one)} -> {"set": True}:
    a salted check of the new one kept (PBKDF2-SHA256), readable by root alone."""
    d = stdin_json()
    if "check" in d:
        r = password_right(d["check"])
        return {"set": r is not None, "right": bool(r)}
    new = str(d.get("new") or "")
    if len(new) < 8:
        raise Failed("A cluster password needs at least 8 characters.")
    if password_right(d.get("old") or "") is False:
        raise Failed("That isn't the cluster password set before on this computer.")
    salt = os.urandom(16)
    check = hashlib.pbkdf2_hmac("sha256", new.encode("utf-8"), salt, PASSWORD_ROUNDS)
    os.makedirs(os.path.dirname(PASSWORD_FILE), exist_ok=True)
    tmp = PASSWORD_FILE + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump({"salt": salt.hex(), "hash": check.hex(), "rounds": PASSWORD_ROUNDS, "at": int(time.time())}, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, PASSWORD_FILE)
    return {"set": True}


def run_as_root():
    """One part of a cluster job as root: {"password", "argv", "cwd", "env"} on stdin, the password checked first.
    The command's own output is passed on as it comes (this helper's answer, a JSON line, comes last); a ".pause" file
    in cwd holds it still and a ".stop" file ends it (the service, not root, can't signal it itself); then what it
    made there is given back to the service's account. cwd: one of the service's own job folders only."""
    name, uid, gid, home = account()
    d = stdin_json()
    right = password_right(d.get("password") or "")
    if right is None:
        raise Failed("No cluster password is set on this device yet: set it in the Jobs tab.")
    if not right:
        raise Failed("That isn't this device's cluster password.")
    argv = d.get("argv")
    if not (isinstance(argv, list) and argv and all(isinstance(a, str) for a in argv)):
        raise Failed("Which command?")
    work = os.path.realpath(os.path.join(home, ".cache", "ht-cluster", "work"))
    cwd = os.path.realpath(str(d.get("cwd") or "/"))
    if not cwd.startswith(work + os.sep) or not os.path.isdir(cwd):
        raise Failed("Only in one of the cluster's own job folders.")
    env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/root", "LANG": "C.UTF-8", "HT_CLUSTER_JOB": "1"}
    for k, v in (d.get("env") or {}).items():
        if re.fullmatch(r"[A-Z][A-Z0-9_]{0,40}", str(k)) and isinstance(v, str) and len(v) < 8192:
            env[k] = v
    sys.stdout.flush()
    p = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, start_new_session=True)
    held = False
    while p.poll() is None:
        try:
            if os.path.exists(os.path.join(cwd, ".stop")):
                os.killpg(p.pid, signal.SIGCONT)
                os.killpg(p.pid, signal.SIGTERM)
                try:
                    p.wait(10)
                except subprocess.TimeoutExpired:
                    os.killpg(p.pid, signal.SIGKILL)
                break
            pause = os.path.exists(os.path.join(cwd, ".pause"))
            if pause != held:
                os.killpg(p.pid, signal.SIGSTOP if pause else signal.SIGCONT)
                held = pause
        except OSError:
            pass
        try:
            p.wait(1)
        except subprocess.TimeoutExpired:
            pass
    code = p.wait()
    for root_dir, dirs, files in os.walk(cwd):
        for n in dirs + files:
            try:
                os.lchown(os.path.join(root_dir, n), uid, gid)
            except OSError:
                pass
    return {"code": code}


# ----- The Pi fixes (modules/fixes.py) -----
# Each is one of the repository's pi/ scripts, as the service's own update brought it (update-cluster:
# checked against GitHub's list of the build's files, into a folder only root can change), run with
# bash: set up, or --remove.

def fetch_fixes():
    """The fixes of the version of the service that's here, when its update didn't bring them (the first
    update to a version with fixes is done by the root helper from before): from GitHub, for that version's
    commit, checked against GitHub's list of its files, into its fixes/ folder."""
    current = os.path.join(INSTALL, "current")
    try:
        with open(os.path.join(current, "VERSION"), "r", encoding="utf-8") as f:
            commit = f.read().strip()
    except OSError:
        commit = ""
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise Missing("This device's version of the service (%s) hasn't got the fixes." % (commit or "?"))
    try:
        tree = json.loads(fetch(API + "/repos/%s/git/trees/%s?recursive=1" % (REPO, commit)).decode("utf-8"))
    except (OSError, ValueError) as e:
        raise Failed("Couldn't list this version's files: %s" % e)
    want = {"pi/%s.sh" % f: f for f in FIXES}
    folder = os.path.join(current, "fixes")
    os.makedirs(folder, exist_ok=True)
    os.chmod(folder, 0o755)
    for e in tree.get("tree") or []:
        path = str(e.get("path") or "")
        if e.get("type") != "blob" or path not in want:
            continue
        try:
            data = fetch("%s/%s/%s/%s" % (RAW, REPO, commit, path))
        except OSError as err:
            raise Failed("Couldn't download %s: %s" % (path, err))
        if git_blob_sha(data) != str(e.get("sha") or ""):
            raise Failed("%s didn't come out as GitHub lists it." % path)
        target = os.path.join(folder, want[path] + ".sh")
        with open(target + ".new", "wb") as f:
            f.write(data)
        os.chmod(target + ".new", 0o644)
        os.replace(target + ".new", target)


def fetch_page():
    """The Cluster page's files for the version of the service that's here, when its update didn't bring
    them (the first update to a version that serves the page is done by the root helper from before): from
    GitHub, for that version's commit, checked against GitHub's list of its files, into its web/ folder."""
    current = current_dir() or os.path.join(INSTALL, "none")
    try:
        with open(os.path.join(current, "VERSION"), "r", encoding="utf-8") as f:
            commit = f.read().strip()
    except OSError:
        commit = ""
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise Missing("This device's version of the service (%s) has no Cluster page to fetch." % (commit or "?"))
    folder = os.path.join(current, "web")
    if all(os.path.isfile(os.path.join(folder, *p.split("/"))) for p in PAGE):
        return {"commit": commit, "unchanged": True}
    try:
        tree = json.loads(fetch(API + "/repos/%s/git/trees/%s?recursive=1" % (REPO, commit)).decode("utf-8"))
    except (OSError, ValueError) as e:
        raise Failed("Couldn't list this version's files: %s" % e)
    got = {}
    for e in tree.get("tree") or []:
        path = str(e.get("path") or "")
        if e.get("type") != "blob" or path not in PAGE:
            continue
        try:
            data = fetch("%s/%s/%s/%s" % (RAW, REPO, commit, path))
        except OSError as err:
            raise Failed("Couldn't download %s: %s" % (path, err))
        if git_blob_sha(data) != str(e.get("sha") or ""):
            raise Failed("%s didn't come out as GitHub lists it." % path)
        got[path] = data
    if "cluster.html" not in got:
        raise Missing("This version of the service has no Cluster page.")
    part = folder + ".part"
    shutil.rmtree(part, ignore_errors=True)
    for path, data in got.items():
        target = os.path.join(part, *path.split("/"))
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "wb") as f:
            f.write(data)
        os.chmod(target, 0o644)
    for root_dir, dirs, _ in os.walk(part):
        for d in dirs:
            os.chmod(os.path.join(root_dir, d), 0o755)
    os.chmod(part, 0o755)
    shutil.rmtree(folder, ignore_errors=True)
    os.replace(part, folder)
    return {"commit": commit, "files": len(got)}


def fix_script(name):
    if name not in FIXES:
        raise Failed("No fix called %s (%s)." % (name, ", ".join(FIXES)))
    path = os.path.join(INSTALL, "current", "fixes", name + ".sh")
    if not os.path.exists(path):
        fetch_fixes()
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        raise Missing("This device's version of the service hasn't got %s yet." % name)
    return path, hashlib.sha256(data).hexdigest()


def fix_install(name):
    path, sha = fix_script(name)
    if name == "network-tuning" and not shutil.which("nft"):  # (what it needs, as it says itself)
        code, out, err = apt(["install", "-y", "-q", "nftables"], 1800, {"DEBIAN_FRONTEND": "noninteractive"})
        if code != 0:
            raise Failed("nftables (which it needs) didn't go in: %s" % apt_why(out, err))
    code, out, err = run(["bash", path], 600)
    if code != 0:
        raise Failed(last_lines(err or out, 2) or "it stopped (%s)" % code)
    return {"fix": name, "sha256": sha, "said": last_lines(out, 2)}


def fix_remove(name):
    path, _ = fix_script(name)
    code, out, err = run(["bash", path, "--remove"], 600)
    if code != 0:
        raise Failed(last_lines(err or out, 2) or "it stopped (%s)" % code)
    return {"fix": name, "said": last_lines(out, 2)}


def wifi_test():
    """As pi/wifi-watchdog.sh --test: the driver reloaded once, 20 s from now (time for this answer to get
    back before the Wi-Fi goes); the watchdog writes how it went to the journal."""
    check = at("/usr/local/sbin/hand-tracker-wifi-watchdog")
    if not os.path.exists(check):
        raise Failed("The Wi-Fi recovery isn't on this device.")
    code, out, err = run(["systemd-run", "--quiet", "--unit=hand-tracker-wifi-watchdog-test-%d" % int(time.time()),
                          "--on-active=20s", "--timer-property=AccuracySec=1s", check, "reload-now"], 60)
    if code != 0:
        raise Failed("The test didn't start: %s" % last_lines(err or out, 1))
    return {"in": 20}


# name: (what it does, how many words after it: 0, or None for "as many as it checks itself", which lock).
# (Transmission's jobs have a lock of their own: they don't wait behind a long system update.)
JOBS = {"install-hand-tracker": (install_hand_tracker, 0, "updates"), "install-app": (install_app, 1, "updates"),
        "update-cluster": (update_cluster, 0, "updates"),
        "verify-cluster": (verify_cluster, 0, "updates"),
        "page": (fetch_page, 0, "updates"),
        "os-check": (os_check, 0, "updates"), "os-upgrade": (os_upgrade, 0, "updates"), "reboot": (reboot, 0, "updates"),
        "poweroff": (poweroff, 0, None),
        "renice-jobs": (renice_jobs, 0, None),
        "install-transmission": (install_transmission, 0, "updates"), "nfs-share": (nfs_share, None, "transmission"),
        "nfs-unshare": (nfs_unshare, 0, "transmission"), "share-folders": (share_folders, None, "updates"), "transmission-start": (transmission_start, None, "transmission"),
        "transmission-stop": (transmission_stop, 0, "transmission"), "transmission-cap": (transmission_cap, 2, None),
        "own-transmission-start": (own_transmission_start, 0, "own-transmission"), "own-transmission-stop": (own_transmission_stop, 0, "own-transmission"),
        "install-libtorrent": (install_libtorrent, 0, "updates"), "install-pyftpdlib": (install_pyftpdlib, 0, "updates"),
        "fix-install": (fix_install, 1, "updates"), "fix-remove": (fix_remove, 1, "updates"), "wifi-test": (wifi_test, 0, None),
        "cluster-password": (cluster_password, 0, None), "run-as-root": (run_as_root, 0, None)}


def main():
    job = sys.argv[1] if len(sys.argv) >= 2 else ""
    words = sys.argv[2:]
    if job not in JOBS or (JOBS[job][1] is not None and len(words) != JOBS[job][1]) or len(words) > 40:
        print(json.dumps({"ok": False, "error": "Jobs: " + ", ".join(JOBS)}))
        return 2
    if WINDOWS and job not in WINDOWS_JOBS:
        print(json.dumps({"ok": False, "error": "Not on Windows: there it does only %s." % ", ".join(WINDOWS_JOBS)}))
        return 1
    fn, _, lock_name = JOBS[job]
    if AS_ROOT:
        os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        os.umask(0o022)
    # A job carries on if the service that asked for it ends meanwhile (restarting itself, say):
    # sudo's terminal going away (SIGHUP) or nobody left to read its answer (SIGPIPE) doesn't stop
    # an install halfway.
    for name in ("SIGHUP", "SIGPIPE"):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), signal.SIG_IGN)
    lock = None
    if fcntl and lock_name:
        os.makedirs(os.path.dirname(LOCK), exist_ok=True)
        lock = open(LOCK if lock_name == "updates" else LOCK + "." + lock_name, "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print(json.dumps({"ok": False, "error": "Another update is going on; try again in a while."}))
            return 1
    started = time.time()
    try:
        answer = dict(fn(*words), ok=True)
    except Missing as e:
        answer = {"ok": False, "missing": True, "error": str(e)}
    except Failed as e:
        answer = {"ok": False, "error": str(e)}
    except Exception as e:  # (anything else: said, not a traceback the service can't read)
        answer = {"ok": False, "error": "%s: %s" % (type(e).__name__, e)}
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a", encoding="utf-8") as f:
            f.write("%s %s %.0fs %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), job, time.time() - started, json.dumps(answer)))
    except OSError:
        pass
    try:
        print(json.dumps(answer), flush=True)
    except OSError:
        pass  # (whoever asked has gone: the log has the answer)
    return 0 if answer["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
