#!/usr/bin/python3 -I
"""
ht-cluster-root - the Cluster service's few root jobs. sudo lets the account the service runs as
run this, and only this, without a password (/etc/sudoers.d/ht-cluster, made by cluster/setup.sh).
It takes nothing from that account but the job's name: whatever it installs, it downloads itself
from this project's GitHub "Latest build" release and checks first.

  ht-cluster-root install-hand-tracker   the latest build's Hand Tracker .deb for this Pi, put in
  ht-cluster-root install-app APP        another of the project's apps from the latest build, put in (APP: hand-mouse,
                                         remote-recording, recording-converter, hand-tracker-cluster, cluster-call)
  ht-cluster-root update-cluster         the latest build's cluster/node files, into /opt/ht-cluster (with the
                                         Cluster page's files, which the service serves itself, in web/)
  ht-cluster-root page                   the Cluster page's files for the version of the service that's here,
                                         when its update didn't bring them (done by the helper from before)
  ht-cluster-root os-check              apt-get update, then which packages have updates
  ht-cluster-root os-upgrade             those updates (no package removed); whether a restart is needed
  ht-cluster-root reboot                 restarts this Pi
  ht-cluster-root renice-jobs            the jobs running at high priority (Cluster's) ahead of everything
  ht-cluster-root install-transmission   Debian's transmission-daemon (its own background service off) and NFS's tools
  ht-cluster-root nfs-share FOLDER...    those folders of your home, and Transmission's settings, shared over NFS
                                         to Tailscale's addresses only (on the Pi that keeps Transmission's files)
  ht-cluster-root nfs-unshare            not shared any more
  ht-cluster-root share-folders [FOLDER...]  those folders of your home (the FTP link's switches; never a hidden one)
                                         shared over NFS to Tailscale's addresses only; none: not shared any more
  ht-cluster-root transmission-start local|ADDRESS FOLDER...
                                         the cluster's Transmission started here as your account; from another
                                         Pi (its Tailscale address), its shared folders mounted and put at their
                                         own paths for Transmission alone
  ht-cluster-root transmission-stop      stopped, and those folders unmounted
  ht-cluster-root transmission-cap DOWN UP   its speeds (kB/s, or none) kept on the Wi-Fi by Linux
  ht-cluster-root own-transmission-start this Pi's own Transmission for the cluster's downloads (downloads.py), as your
                                         account, its settings in ~/.local/share/ht-cluster/own-transmission
  ht-cluster-root own-transmission-stop  stopped
  ht-cluster-root install-libtorrent     Debian's python3-libtorrent (for a download split by pieces: pieces.py)
  ht-cluster-root install-pyftpdlib      Debian's python3-pyftpdlib (the phones' FTP link to this Pi's shared folders: modules/ftp.py)
  ht-cluster-root fix-install FIX        one of the Pi fixes (pi/FIX.sh: wifi-watchdog, tailscale-watchdog,
                                         network-tuning, freeze-restart, usb-current, wifi-autoconnect, drive-reset,
                                         sd-fallback) set up, as the service's own update
                                         brought it (/opt/ht-cluster/current/fixes, checked against GitHub's list)
  ht-cluster-root fix-remove FIX         that fix taken away (its --remove)
  ht-cluster-root wifi-test              the Wi-Fi recovery's test: the Wi-Fi driver reloaded once, 20 s later

Each prints one line of JSON: {"ok": true, ...} or {"ok": false, "error": "..."}. One job at a time.
Run as another user than root (the checks), HT_CLUSTER_GITHUB_API, HT_CLUSTER_GITHUB_RAW and
HT_CLUSTER_ROOT_DIR (a folder standing in for /) point it elsewhere; as root, nothing can.
"""

import hashlib
import hmac
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.request

try:
    import fcntl
except ImportError:  # (not on Windows, where only its checks run)
    fcntl = None

REPO = "alexandermulholland92/hand-tracker"
AS_ROOT = hasattr(os, "getuid") and os.getuid() == 0
TESTING = not AS_ROOT
API = (os.environ.get("HT_CLUSTER_GITHUB_API") if TESTING else None) or "https://api.github.com"
RAW = (os.environ.get("HT_CLUSTER_GITHUB_RAW") if TESTING else None) or "https://raw.githubusercontent.com"
BASE = (os.environ.get("HT_CLUSTER_ROOT_DIR") if TESTING else None) or "/"


def at(path):
    return os.path.join(BASE, path.lstrip("/"))


INSTALL = at("/opt/ht-cluster")
CACHE = at("/var/cache/ht-cluster")
RECORD = at("/var/lib/ht-cluster/hand-tracker.json")
HELPER = at("/usr/local/sbin/ht-cluster-root")
LOCK = at("/run/ht-cluster-root.lock")
LOG = at("/var/log/ht-cluster-root.log")
# On a Windows PC (ht_cluster.py's node.root there, run as the user with HT_CLUSTER_WINDOWS=1): only this service's
# own update and the page, into its folder (HT_CLUSTER_INSTALL, else %USERPROFILE%/Cluster, or one it was in before
# while that's the one there: %LOCALAPPDATA%/Cluster, %LOCALAPPDATA%/Pi Cluster), where the version in use is named in
# current.txt (no symbolic link), which its launcher (windows/launcher.py) reads.
WINDOWS = os.name == "nt" and os.environ.get("HT_CLUSTER_WINDOWS") == "1"
WINDOWS_JOBS = ("update-cluster", "verify-cluster", "page", "cluster-password")


def windows_folder():
    """%USERPROFILE%/Cluster, or one the PC's folder was in before while only that one is there (setup.py moves it):
    %LOCALAPPDATA%/Cluster (until 2026-11-25: AppData isn't seen alike by every program), %LOCALAPPDATA%/Pi Cluster
    (before the rename)."""
    new = os.path.join(os.path.expanduser("~"), "Cluster")
    local = os.environ.get("LOCALAPPDATA") or os.path.expanduser("~")
    if os.path.isfile(os.path.join(new, "launcher.py")):
        return new
    for old in (os.path.join(local, "Cluster"), os.path.join(local, "Pi Cluster")):
        if os.path.isfile(os.path.join(old, "launcher.py")):
            return old
    return new


if WINDOWS:
    INSTALL = os.environ.get("HT_CLUSTER_INSTALL") or windows_folder()
    LOG = os.path.join(INSTALL, "root.log")
SAFE_PATH = re.compile(r"^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$")
# The Pi fixes (modules/fixes.py): pi/<name>.sh in the repository, brought with the service's own update
# into its fixes/ folder.
FIXES = ("wifi-watchdog", "tailscale-watchdog", "network-tuning", "freeze-restart", "usb-current", "wifi-autoconnect",
         "drive-reset", "sd-fallback")
# The Cluster page and the files it loads, which the service serves itself (ht_cluster.py PAGE_FILES):
# from the repository's top folder, brought with the service's own update into its web/ folder. (Named
# pi-cluster.html and pi-cluster.js before the rename, 2026-11-25: the update to the first build with the new names is
# done by the root helper from before, which looks for the old ones and so brings the rest; the page step then fetches
# these, as for any version whose update didn't bring its page.)
PAGE = ("cluster.html", "cluster.js", "video-formats.js", "sentry-models.js", "models/kinds.js", "favicon.png", "apple-touch-icon.png")


class Failed(Exception):
    pass


class Missing(Failed):  # (the latest build hasn't got it: nothing wrong, it's just not there yet)
    pass


def run(cmd, timeout=600, env=None):
    e = dict(os.environ, **(env or {}))
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=e)
    except (OSError, subprocess.TimeoutExpired) as err:
        raise Failed("%s: %s" % (cmd[0], err))
    return p.returncode, p.stdout or "", p.stderr or ""


def last_lines(text, n=3):
    lines = [l.strip() for l in (text or "").strip().splitlines() if l.strip()]
    return " / ".join(lines[-n:])[:400]


def apt_why(out, err):
    """What apt said went wrong, in a line: its first error (E:), else its last lines."""
    errors = [l.strip() for l in ((err or "") + "\n" + (out or "")).splitlines() if l.strip().startswith("E:")]
    if errors:
        first = errors[0][2:].strip()
        if "Failed to fetch" in first or "Unable to fetch" in first:
            m = re.search(r"(Temporary failure resolving '[^']+'|Could not connect to [^ ]+|Connection timed out|Network is unreachable|Connection failed|\d{3} [A-Za-z ]+)", " ".join(errors))
            return "couldn't download some packages" + (" (%s)" % m.group(1).strip() if m else "")
        return first[:200]
    return last_lines(err or out, 1)[:200]


# apt's downloads: tried 3 times each; and when they fail, once more over IPv4 only (a Pi whose IPv6
# route is there but goes nowhere gets "Ign" for every package).
APT_NET = ["-o", "Acquire::Retries=3"]


def apt(args, timeout, env=None, prefix=()):
    code, out, err = run(list(prefix) + ["apt-get"] + APT_NET + args, timeout, env)
    if code != 0 and re.search(r"(Failed to fetch|Unable to fetch|Temporary failure resolving|Could not connect)", (out or "") + (err or "")):
        code, out, err = run(list(prefix) + ["apt-get"] + APT_NET + ["-o", "Acquire::ForceIPv4=true"] + args, timeout, env)
    return code, out, err


def fetch(url, timeout=60):
    req = urllib.request.Request(url, headers={"User-Agent": "ht-cluster", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=timeout) as res:
        return res.read()


def release():
    try:
        rel = json.loads(fetch(API + "/repos/%s/releases/tags/latest-build" % REPO).decode("utf-8"))
    except (OSError, ValueError) as e:
        raise Failed("Couldn't read GitHub's latest build: %s" % e)
    commit = str(rel.get("target_commitish") or "")
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise Failed("GitHub's latest build doesn't say which commit it is.")
    rel["commit"] = commit
    return rel


def download(url, dest, size=None, sha256=None):
    """url -> dest, checked against its size and SHA-256 (as GitHub gives them) before it's kept."""
    part = dest + ".part"
    h = hashlib.sha256()
    got = 0
    req = urllib.request.Request(url, headers={"User-Agent": "ht-cluster"})
    try:
        with urllib.request.urlopen(req, timeout=120) as res, open(part, "wb") as out:
            while True:
                chunk = res.read(1 << 20)
                if not chunk:
                    break
                out.write(chunk)
                h.update(chunk)
                got += len(chunk)
    except OSError as e:
        raise Failed("Download failed: %s" % e)
    if size is not None and got != int(size):
        os.remove(part)
        raise Failed("The download came out %d bytes, not %d." % (got, int(size)))
    if sha256 and h.hexdigest() != sha256.lower():
        os.remove(part)
        raise Failed("The download's SHA-256 isn't the one GitHub gives.")
    os.replace(part, dest)


def git_blob_sha(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def arch():
    code, out, _ = run(["dpkg", "--print-architecture"], 10)
    if code != 0 or not out.strip():
        raise Failed("Couldn't tell this device's processor (dpkg --print-architecture).")
    return out.strip()


def install_hand_tracker():
    rel = release()
    a = arch()
    asset = next((x for x in rel.get("assets") or [] if re.fullmatch(r"hand-tracker_[^_]+_%s\.deb" % re.escape(a), str(x.get("name") or ""))), None)
    if not asset:
        raise Failed("The latest build has no Hand Tracker for %s." % a)
    digest = str(asset.get("digest") or "")
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, "hand-tracker.deb")
    download(str(asset["browser_download_url"]), path, asset.get("size"), digest[7:] if digest.startswith("sha256:") else None)
    try:
        code, out, err = run(["dpkg-deb", "-f", path, "Package"], 60)
        if code != 0 or out.strip() != "hand-tracker":
            raise Failed("That download isn't Hand Tracker's package.")
        run(["dpkg", "--configure", "-a"], 1800, {"DEBIAN_FRONTEND": "noninteractive"})  # (one left half done before, finished first)
        code, out, err = apt(["install", "-y", "-q", "--reinstall",
                              "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold", path],
                             1800, {"DEBIAN_FRONTEND": "noninteractive"})
        if code != 0:
            raise Failed("It didn't go in: %s" % apt_why(out, err))
    finally:
        if os.path.exists(path):
            os.remove(path)
    os.makedirs(os.path.dirname(RECORD), exist_ok=True)
    with open(RECORD + ".new", "w", encoding="utf-8") as f:
        json.dump({"commit": rel["commit"], "asset": asset["name"], "updated": asset.get("updated_at"), "digest": digest, "at": time.time()}, f)
    os.chmod(RECORD + ".new", 0o644)
    os.replace(RECORD + ".new", RECORD)
    return {"commit": rel["commit"], "asset": asset["name"]}


# The project's other apps a Pi can have (their .deb packages, each named as its app: scripts/dist.js), put in from
# Cluster's page (modules/installs.py). Hand Tracker itself is install-hand-tracker's.
APPS = ("hand-mouse", "remote-recording", "recording-converter", "hand-tracker-cluster", "cluster-call")


def install_app(app):
    """One of APPS from the latest build, for this Pi's processor: checked against GitHub's size and SHA-256, then put in
    (as Hand Tracker is: apt, its package's own name checked first)."""
    if app not in APPS:
        raise Failed("Apps: " + ", ".join(APPS))
    rel = release()
    a = arch()
    asset = next((x for x in rel.get("assets") or [] if re.fullmatch(r"%s_[^_]+_%s\.deb" % (re.escape(app), re.escape(a)), str(x.get("name") or ""))), None)
    if not asset:
        raise Failed("The latest build has no %s for %s." % (app, a))
    digest = str(asset.get("digest") or "")
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, app + ".deb")
    download(str(asset["browser_download_url"]), path, asset.get("size"), digest[7:] if digest.startswith("sha256:") else None)
    try:
        code, out, err = run(["dpkg-deb", "-f", path, "Package"], 60)
        if code != 0 or out.strip() != app:
            raise Failed("That download isn't %s's package." % app)
        run(["dpkg", "--configure", "-a"], 1800, {"DEBIAN_FRONTEND": "noninteractive"})  # (one left half done before, finished first)
        code, out, err = apt(["install", "-y", "-q", "--reinstall",
                              "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold", path],
                             1800, {"DEBIAN_FRONTEND": "noninteractive"})
        if code != 0:
            raise Failed("It didn't go in: %s" % apt_why(out, err))
    finally:
        if os.path.exists(path):
            os.remove(path)
    return {"commit": rel["commit"], "asset": asset["name"]}


def current_dir():
    """The version of the service in use: INSTALL/current (a link to it), or on Windows the one current.txt names."""
    if not WINDOWS:
        return os.path.join(INSTALL, "current")
    try:
        with open(os.path.join(INSTALL, "current.txt"), "r", encoding="utf-8") as f:
            name = f.read().strip()
    except OSError:
        return None
    return os.path.join(INSTALL, "versions", name) if re.fullmatch(r"[0-9a-f]{40}|dev", name) else None


def files_of(commit):
    """A build's files for the service, as GitHub lists them: [(path in the version's folder, path in the
    repository, its git blob SHA)]: cluster/node's, the Pi fixes (fixes/) and the page (web/)."""
    try:
        tree = json.loads(fetch(API + "/repos/%s/git/trees/%s?recursive=1" % (REPO, commit)).decode("utf-8"))
    except (OSError, ValueError) as e:
        raise Failed("Couldn't list the build's files: %s" % e)
    prefix = "cluster/node/"
    fixes = {"pi/%s.sh" % f: "fixes/%s.sh" % f for f in FIXES}
    page = {p: "web/" + p for p in PAGE}
    files = []
    for e in tree.get("tree") or []:
        path = str(e.get("path") or "")
        if e.get("type") != "blob":
            continue
        if path in fixes:  # (the Pi fixes, with the service: modules/fixes.py puts them in)
            files.append((fixes[path], path, str(e.get("sha") or "")))
            continue
        if path in page:  # (the Cluster page, which the service serves)
            files.append((page[path], path, str(e.get("sha") or "")))
            continue
        if not path.startswith(prefix):
            continue
        rel_path = path[len(prefix):]
        if (not SAFE_PATH.match(rel_path) or ".." in rel_path.split("/") or "__pycache__" in rel_path
                or rel_path.startswith("fixes/") or rel_path.startswith("web/")):
            continue
        files.append((rel_path, path, str(e.get("sha") or "")))
    if not any(f[0] == "ht_cluster.py" for f in files):
        raise Missing("That build has no Cluster service in it yet.")
    return files


def verify_cluster():
    """The service's files checked after a start (the user, 2026-11-22, from a capture rig's own fix: files a power
    cut damaged put back): each of the version in use against GitHub's list for its commit, and one that isn't as
    listed, or is missing, downloaded again (checked as an update's are); and the root helper's own copy against
    the version's. -> {"commit", "checked", "repaired": [paths]}"""
    current = current_dir()
    try:
        with open(os.path.join(current or os.path.join(INSTALL, "none"), "VERSION"), "r", encoding="utf-8") as f:
            commit = f.read().strip()
    except OSError:
        commit = ""
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise Missing("This copy of the service (%s) has no build to check it against." % (commit or "no version"))
    files = files_of(commit)
    repaired = []
    for rel_path, path, sha in files:
        target = os.path.join(current, *rel_path.split("/"))
        try:
            with open(target, "rb") as f:
                if git_blob_sha(f.read()) == sha:
                    continue
        except OSError:
            pass
        try:
            data = fetch("%s/%s/%s/%s" % (RAW, REPO, commit, path))
        except OSError as e:
            raise Failed("Couldn't download %s again: %s" % (path, e))
        if git_blob_sha(data) != sha:
            raise Failed("%s didn't come out as GitHub lists it." % path)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target + ".new", "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(target + ".new", 0o755 if rel_path == "ht-cluster-root" else 0o644)
        os.replace(target + ".new", target)
        repaired.append(rel_path)
    if not WINDOWS:
        with open(os.path.join(current, "ht-cluster-root"), "rb") as f:
            want = f.read()
        try:
            with open(HELPER, "rb") as f:
                same = f.read() == want
        except OSError:
            same = False
        if not same:
            with open(HELPER + ".new", "wb") as f:
                f.write(want)
                f.flush()
                os.fsync(f.fileno())
            os.chmod(HELPER + ".new", 0o755)
            os.replace(HELPER + ".new", HELPER)
            repaired.append(HELPER)
    return {"commit": commit, "checked": len(files), "repaired": repaired}


def update_cluster():
    rel = release()
    commit = rel["commit"]
    current = current_dir() or os.path.join(INSTALL, "none")
    try:
        with open(os.path.join(current, "VERSION"), "r", encoding="utf-8") as f:
            if f.read().strip() == commit:
                return {"commit": commit, "unchanged": True}
    except OSError:
        pass
    files = files_of(commit)
    versions = os.path.join(INSTALL, "versions")
    dest = os.path.join(versions, commit)
    part = dest + ".part"
    shutil.rmtree(part, ignore_errors=True)
    os.makedirs(part)
    for rel_path, path, sha in files:
        try:
            data = fetch("%s/%s/%s/%s" % (RAW, REPO, commit, path))
        except OSError as e:
            raise Failed("Couldn't download %s: %s" % (path, e))
        if git_blob_sha(data) != sha:
            raise Failed("%s didn't come out as GitHub lists it." % path)
        target = os.path.join(part, *rel_path.split("/"))
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "wb") as f:
            f.write(data)
        os.chmod(target, 0o755 if rel_path == "ht-cluster-root" else 0o644)
    with open(os.path.join(part, "VERSION"), "w", encoding="utf-8") as f:
        f.write(commit + "\n")
    for root_dir, dirs, _ in os.walk(part):
        for d in dirs:
            os.chmod(os.path.join(root_dir, d), 0o755)
    os.chmod(part, 0o755)
    shutil.rmtree(dest, ignore_errors=True)
    os.replace(part, dest)
    if WINDOWS:  # (the launcher starts it from there when this service ends: no link, no helper of its own to put in)
        previous = current_dir()
        with open(os.path.join(INSTALL, "current.txt.new"), "w", encoding="utf-8") as f:
            f.write(commit + "\n")
        os.replace(os.path.join(INSTALL, "current.txt.new"), os.path.join(INSTALL, "current.txt"))
        keep = {os.path.realpath(dest), os.path.realpath(previous) if previous else None}
        for name in os.listdir(versions):
            p = os.path.join(versions, name)
            if os.path.realpath(p) not in keep and name != "dev":
                shutil.rmtree(p, ignore_errors=True)
        return {"commit": commit}
    previous = os.path.realpath(current) if os.path.islink(current) else None
    link = current + ".new"
    if os.path.lexists(link):
        os.remove(link)
    os.symlink(dest, link)
    os.replace(link, current)
    helper_new = HELPER + ".new"
    shutil.copyfile(os.path.join(dest, "ht-cluster-root"), helper_new)
    os.chmod(helper_new, 0o755)
    os.replace(helper_new, HELPER)
    keep = {os.path.realpath(dest), previous}
    for name in os.listdir(versions):
        p = os.path.join(versions, name)
        if os.path.realpath(p) not in keep:
            shutil.rmtree(p, ignore_errors=True)
    return {"commit": commit}


def os_check():
    code, out, err = apt(["update", "-q"], 900, {"DEBIAN_FRONTEND": "noninteractive"})
    if code != 0:
        raise Failed("Couldn't look for updates: %s" % apt_why(out, err))
    code, out, err = run(["apt-get", "-s", "-q", "upgrade", "--with-new-pkgs"], 300)
    if code != 0:
        raise Failed("Couldn't work out the updates: %s" % apt_why(out, err))
    names = [l.split()[1] for l in out.splitlines() if l.startswith("Inst ") and len(l.split()) > 1]
    return {"upgradable": len(names), "packages": names[:30]}


def kernel_marks():
    marks = []
    for d in ("/lib/modules",):
        try:
            marks += sorted(os.listdir(d))
        except OSError:
            pass
    for d in ("/boot/firmware", "/boot"):
        try:
            for n in sorted(os.listdir(d)):
                if n.startswith(("kernel", "initramfs", "vmlinuz", "initrd")):
                    st = os.stat(os.path.join(d, n))
                    marks.append("%s/%s:%d:%d" % (d, n, st.st_size, int(st.st_mtime)))
        except OSError:
            pass
    return marks


def os_upgrade():
    before = kernel_marks()
    env = {"DEBIAN_FRONTEND": "noninteractive", "NEEDRESTART_MODE": "l"}
    run(["dpkg", "--configure", "-a"], 1800, env)  # (one left half done before, finished first)
    code, out, err = apt(["-y", "-q", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold",
                          "upgrade", "--with-new-pkgs"], 3600, env, prefix=("nice", "-n", "10", "ionice", "-c3"))
    if code != 0:
        raise Failed(apt_why(out, err))
    m = re.search(r"(\d+) upgraded, (\d+) newly installed", out)
    upgraded = (int(m.group(1)) + int(m.group(2))) if m else None
    reboot = kernel_marks() != before or os.path.exists("/run/reboot-required")
    return {"upgraded": upgraded, "rebootNeeded": reboot}


def reboot():
    code, out, err = run(["systemctl", "reboot"], 60)
    if code != 0:
        raise Failed("Couldn't restart: %s" % last_lines(err or out))
    return {}


def poweroff():
    """This Pi shut down cleanly (modules/health.py: its battery nearly empty, any recording saved first)."""
    code, out, err = run(["systemctl", "poweroff"], 60)
    if code != 0:
        raise Failed("Couldn't shut down: %s" % last_lines(err or out))
    return {}


def renice_jobs():
    """Jobs at high priority (Cluster's jobs.py): its account's job programs (marked HT_CLUSTER_JOB=1
    as it starts them) ahead of everything else: nice -10, and first for the drive."""
    uid = os.environ.get("SUDO_UID")
    if not AS_ROOT or not uid or not uid.isdigit():
        raise Failed("Only through sudo.")
    done = 0
    for pid in [p for p in os.listdir("/proc") if p.isdigit()]:
        try:
            if os.stat("/proc/" + pid).st_uid != int(uid):
                continue
            with open("/proc/%s/environ" % pid, "rb") as f:
                if b"HT_CLUSTER_JOB=1" not in f.read().split(b"\0"):
                    continue
            os.setpriority(os.PRIO_PROCESS, int(pid), -10)
            run(["ionice", "-c2", "-n0", "-p", pid], 10)
            done += 1
        except (OSError, Failed):
            continue
    return {"reniced": done}



# ----- Transmission, run by the cluster (modules/apps.py) -----
# Its settings and torrents live on the Pi that keeps its files (TR_CONFIG, under the account's home);
# the folders its torrents save into are shared from there over NFS, only to Tailscale's addresses,
# and on another Pi running it they're mounted under TR_MNT and put back at their own paths for
# Transmission alone (its service's BindPaths), so every torrent keeps its folder.
TR_CONFIG = ".local/share/ht-cluster/transmission"
TR_MNT = "/mnt/ht-cluster/transmission"
TR_UNIT = "ht-cluster-transmission"
TR_GROUP = "ht-capped"  # (pi/download-cap.sh's group: its connections are what the caps below count)
TR_EXPORTS = "/etc/exports.d/ht-cluster.exports"
SHARES = "/etc/exports.d/ht-cluster-shares.exports"  # (the FTP link's switches: modules/ftp.py)
TR_TABLE = "inet ht_cluster_cap"
FOLDER = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 _.+-]{0,59}$")
TAILSCALE_V4 = re.compile(r"^100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}$")


def account():
    """The account the cluster's service runs as (the one sudo was asked by): (name, uid, gid, home)."""
    import pwd
    name = os.environ.get("SUDO_USER") or ""
    if not AS_ROOT or not name or name == "root":
        raise Failed("Only through sudo, from the service's account.")
    p = pwd.getpwnam(name)
    return name, p.pw_uid, p.pw_gid, p.pw_dir


def installed(package):
    code, out, _ = run(["dpkg-query", "-W", "-f", "${db:Status-Status}", package], 30)
    return code == 0 and out.strip() == "installed"


def folders(names):
    """Folder names in the account's home (as given by the service), checked: plain names of folders there."""
    _, _, _, home = account()
    out = []
    for n in names:
        if not FOLDER.match(n) or not os.path.isdir(os.path.join(home, n)) or os.path.islink(os.path.join(home, n)):
            raise Failed("%s isn't a folder in your home that can be shared." % n)
        out.append(n)
    return sorted(set(out))


def install_transmission():
    name, _, _, _ = account()
    had = installed("transmission-daemon")
    wanted = [p for p in ("transmission-daemon", "nfs-common", "nftables") if not installed(p)]
    if wanted:
        code, out, err = apt(["install", "-y", "-q"] + wanted, 1800, {"DEBIAN_FRONTEND": "noninteractive"})
        if code != 0:
            raise Failed("Transmission didn't go in: %s" % apt_why(out, err))
    if not had:  # (Debian's own background Transmission, which comes with it: off, unless it was there before)
        run(["systemctl", "disable", "--now", "transmission-daemon"], 120)
    if run(["getent", "group", TR_GROUP], 10)[0] != 0:
        run(["groupadd", "--system", TR_GROUP], 30)
    run(["usermod", "-aG", TR_GROUP, name], 30)
    return {"installed": wanted}


def nfs_share(*names):
    name, uid, gid, home = account()
    shared = folders(names)
    os.makedirs(os.path.join(home, TR_CONFIG), exist_ok=True)
    if not installed("nfs-kernel-server"):
        code, out, err = apt(["install", "-y", "-q", "nfs-kernel-server"], 1800, {"DEBIAN_FRONTEND": "noninteractive"})
        if code != 0:
            raise Failed("The share didn't go in: %s" % apt_why(out, err))
    opts = "rw,sync,no_subtree_check,all_squash,anonuid=%d,anongid=%d" % (uid, gid)
    lines = ["# Cluster: Transmission's folders, to Tailscale's addresses only (ht-cluster-root nfs-share)"]
    for p in [os.path.join(home, n) for n in shared] + [os.path.join(home, TR_CONFIG)]:
        lines.append('"%s" 100.64.0.0/10(%s)' % (p, opts))
    os.makedirs(os.path.dirname(TR_EXPORTS), exist_ok=True)
    with open(TR_EXPORTS + ".new", "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(TR_EXPORTS + ".new", TR_EXPORTS)
    run(["systemctl", "enable", "--now", "nfs-server"], 120)
    code, out, err = run(["exportfs", "-ra"], 120)
    if code != 0:
        raise Failed("The share didn't take: %s" % last_lines(err or out, 1))
    return {"shared": shared}


def nfs_unshare():
    if os.path.exists(TR_EXPORTS):
        os.remove(TR_EXPORTS)
        run(["exportfs", "-ra"], 120)
    return {}


def share_folders(*names):
    """The folders the FTP link's switches share over NFS (modules/ftp.py; the user, 2026-11-25), for the PC's drives:
    plain names of folders in your home, to Tailscale's addresses only. Never your whole home: it goes as each folder
    in it that isn't hidden (NFS can't leave hidden ones out of a share: "exclude hidden folders from the whole home
    share"), and a hidden name isn't a plain one. With none, not shared any more."""
    _, uid, gid, home = account()
    paths = [os.path.join(home, n) for n in folders(names)]
    if not paths:
        if os.path.exists(SHARES):
            os.remove(SHARES)
            run(["exportfs", "-ra"], 120)
        return {"shared": []}
    if not installed("nfs-kernel-server"):
        code, out, err = apt(["install", "-y", "-q", "nfs-kernel-server"], 1800, {"DEBIAN_FRONTEND": "noninteractive"})
        if code != 0:
            raise Failed("The share didn't go in: %s" % apt_why(out, err))
    opts = "rw,sync,no_subtree_check,all_squash,anonuid=%d,anongid=%d" % (uid, gid)
    lines = ["# Cluster: the FTP link's shared folders, to Tailscale's addresses only (ht-cluster-root share-folders)"]
    lines += ['"%s" 100.64.0.0/10(%s)' % (p, opts) for p in paths]
    os.makedirs(os.path.dirname(SHARES), exist_ok=True)
    with open(SHARES + ".new", "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(SHARES + ".new", SHARES)
    run(["systemctl", "enable", "--now", "nfs-server"], 120)
    code, out, err = run(["exportfs", "-ra"], 120)
    if code != 0:
        raise Failed("The share didn't take: %s" % last_lines(err or out, 1))
    return {"shared": [os.path.basename(p) for p in paths]}


def transmission_stop():
    run(["systemctl", "stop", TR_UNIT], 120)
    if os.path.isdir(TR_MNT):
        for n in os.listdir(TR_MNT):
            run(["umount", "-l", os.path.join(TR_MNT, n)], 60)
    return {}


def transmission_start(where, *names):
    """where: "local" (this Pi has the files) or the Tailscale address of the Pi that has them."""
    name, uid, gid, home = account()
    if where != "local" and not TAILSCALE_V4.match(where):
        raise Failed("Not a Tailscale address: %s" % where)
    shared = folders(names) if where == "local" else [n for n in names if FOLDER.match(n)]
    transmission_stop()
    binds = []
    if where != "local":
        os.makedirs(TR_MNT, exist_ok=True)
        for key, rel in [(n, n) for n in shared] + [("_settings", TR_CONFIG)]:
            mnt = os.path.join(TR_MNT, key)
            os.makedirs(mnt, exist_ok=True)
            code, out, err = run(["mount", "-t", "nfs4", "-o", "soft,timeo=150,retrans=3,nosuid,nodev,noexec",
                                  "%s:%s" % (where, os.path.join(home, rel)), mnt], 120)
            if code != 0:
                transmission_stop()
                raise Failed("Couldn't reach %s's %s: %s" % (where, rel, last_lines(err or out, 1)))
            dest = os.path.join(home, rel)
            if not os.path.isdir(dest):
                os.makedirs(dest, exist_ok=True)
                os.chown(dest, uid, gid)
            binds.append("%s:%s" % (mnt, dest))
    group = TR_GROUP if run(["getent", "group", TR_GROUP], 10)[0] == 0 else str(gid)
    cmd = ["systemd-run", "--unit=" + TR_UNIT, "--collect", "-p", "User=" + name, "-p", "Group=" + group,
           "-p", "UMask=0022", "-p", "Restart=on-failure", "-p", "RestartSec=10", "-p", "Nice=5",
           "-p", "Description=Cluster's Transmission"]
    for b in binds:
        cmd += ["-p", "BindPaths=" + b]
    cmd += ["/usr/bin/transmission-daemon", "-f", "--log-level=error", "-g", os.path.join(home, TR_CONFIG)]
    code, out, err = run(cmd, 60)
    if code != 0:
        transmission_stop()
        raise Failed("Transmission didn't start: %s" % last_lines(err or out, 1))
    return {"started": where}


def transmission_cap(down, up):
    """Transmission's own limits (kB/s, "none" for no limit), kept by Linux on the Wi-Fi for its group's
    connections, as pi/download-cap.sh does on pi: this Transmission goes over its own limits."""
    def rate(v):
        if v == "none":
            return None
        if not v.isdigit() or not 1 <= int(v) <= 1000000:
            raise Failed("Not a speed: %s" % v)
        return int(v) * 1000
    d, u = rate(down), rate(up)
    code, out, _ = run(["getent", "group", TR_GROUP], 10)
    if code != 0:
        raise Failed("No %s group here (install-transmission makes it)." % TR_GROUP)
    gid = out.split(":")[2]
    over = lambda r: "limit rate over %d bytes/second burst %d bytes drop" % (r, max(r // 2, 30000))
    rules = ["table %s" % TR_TABLE, "delete table %s" % TR_TABLE, "table %s {" % TR_TABLE,
             "  chain out {", "    type filter hook output priority mangle; policy accept;",
             "    meta skgid %s ct mark set ct mark or 0x02000000" % gid]
    if u is not None:
        rules.append('    oifname "wlan0" ct mark and 0x02000000 == 0x02000000 %s' % over(u))
    rules += ["  }", "  chain in {", "    type filter hook prerouting priority mangle; policy accept;"]
    if d is not None:
        rules.append('    iifname "wlan0" ct mark and 0x02000000 == 0x02000000 %s' % over(d))
    rules += ["  }", "}"]
    p = subprocess.run(["nft", "-f", "-"], input="\n".join(rules) + "\n", text=True, capture_output=True, timeout=60)
    if p.returncode != 0:
        raise Failed("nft: %s" % last_lines(p.stderr, 1))
    return {"down": down, "up": up}


