<?xml version="1.0" encoding="utf-8"?>
<!-- Hand Mouse (the "mouse" flavor): src/main's manifest without what only Hand Tracker uses (2026-11-16, for
     Google Play, which asks why an app has each permission). Hand Mouse keeps the camera, its window over other
     apps, hand control (the accessibility service), its camera's foreground service and notification, the
     network (a computer controlled over Wi-Fi), and Bluetooth as a computer's mouse and keyboard (BtHidPlugin:
     BLUETOOTH_CONNECT and _ADVERTISE; BLUETOOTH and _ADMIN before Android 12). Left out: Sentry's watch while
     closed and after a restart (its service and boot receiver, special-use foreground service, wake lock),
     sound, old storage, finding Bluetooth rigs and OptiTrack (scan, location, multicast, network switching),
     the dashboard's sign-in, and telling Pi Cluster whether it's recording (it doesn't record). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission android:name="com.handtracker.permission.APP_STATE" tools:node="remove" />
    <uses-permission android:name="com.handtracker.permission.APP_STATE" tools:node="remove" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" tools:node="remove" />

    <application>
        <service android:name=".SentryWatchService" tools:node="remove" />
        <receiver android:name=".SentryWatchBoot" tools:node="remove" />
        <activity android:name=".SignInActivity" tools:node="remove" />
        <provider android:name=".AppStateProvider" tools:node="remove" />
    </application>
</manifest>
