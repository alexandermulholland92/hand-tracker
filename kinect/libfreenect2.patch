+/** Pipeline with the color camera's own JPEG (not decoded: a Raw frame, its length in
+ * bytes_per_pixel) and CPU depth processing (Hand Tracker). */
+class LIBFREENECT2_API JpegCpuPacketPipeline : public PacketPipeline
+{
+public:
+  JpegCpuPacketPipeline();
+  virtual ~JpegCpuPacketPipeline();
+};
+
+#ifdef LIBFREENECT2_WITH_OPENGL_SUPPORT
+/** As JpegCpuPacketPipeline, with OpenGL depth processing (Hand Tracker). */
+class LIBFREENECT2_API JpegOpenGLPacketPipeline : public PacketPipeline
+{
+public:
+  JpegOpenGLPacketPipeline();
+  virtual ~JpegOpenGLPacketPipeline();
+};
+#endif // LIBFREENECT2_WITH_OPENGL_SUPPORT
