{
  "name": "hand-tracker",
  "productName": "Hand Tracker",
  "version": "1.1.0",
  "description": "Real-time hand landmark tracking with 3D visualization, robot-motion capture and multi-format video export.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "alexandermulholland92 <298000350+alexandermulholland92@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandermulholland92/hand-tracker.git"
  },
  "homepage": "https://hand-tracker.pages.dev",
  "main": "electron/main.js",
  "desktopName": "hand-tracker.desktop",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.js",
    "check": "node scripts/run-checks.js scripts/check.js",
    "dist": "node scripts/dist.js portable",
    "dist:installer": "node scripts/dist.js nsis",
    "dist:deb": "node scripts/dist.js deb",
    "dist:deb-arm64": "node scripts/dist.js deb --arm64",
    "build:web": "node scripts/build-web.js",
    "android:sync": "node scripts/build-web.js && cap sync android",
    "android:apk": "node scripts/build-android.js",
    "check:android": "node scripts/run-checks.js scripts/check-android.js",
    "deploy:web": "node scripts/build-web.js && npx --yes wrangler@4 pages deploy www --project-name hand-tracker --commit-dirty=true --branch \"hand tracker\" && npx --yes wrangler@4 pages deploy www --project-name hand-tracker --commit-dirty=true --branch main"
  },
  "dependencies": {
    "@mediapipe/drawing_utils": "0.3.1620248257",
    "@mediapipe/hands": "0.4.1646424915",
    "@mediapipe/pose": "0.5.1675469404",
    "@tesseract.js-data/eng": "^1.0.0",
    "ffmpeg-static": "^5.3.0",
    "tesseract.js": "^7.0.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.handtracker.app",
    "productName": "Hand Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "oak/**",
      "!oak/__pycache__/**",
      "index.html",
      "viewer.html",
      "camera-tile.html",
      "phone-control.html",
      "keyboard.html",
      "remote.html",
      "*.js",
      "*.css",
      "!scripts/**",
      "!node_modules/three/src/**",
      "!node_modules/@mediapipe/pose/pose_landmark_{full,heavy}.tflite",
      "!node_modules/three/examples/jsm/**",
      "!node_modules/three/examples/fonts/**",
      "!node_modules/ffmpeg-static/*.md",
      "!node_modules/tesseract.js/dist/*.map",
      "!node_modules/tesseract.js/dist/tesseract.esm.min.js",
      "!node_modules/tesseract.js/src/**",
      "!node_modules/tesseract.js-core/*.wasm",
      "!node_modules/tesseract.js-core/*-lstm.js",
      "!node_modules/tesseract.js-core/tesseract-core{,-simd,-relaxedsimd}.{js,wasm.js}",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "electron/tak-convert.ps1",
      "electron/input-helper.ps1",
      "oak/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "HandTracker-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "HandTracker-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "deb",
      "icon": "build/icons",
      "category": "Video",
      "synopsis": "Hand tracking, motion capture and video tools"
    },
    "deb": {
      "artifactName": "hand-tracker_${version}_${arch}.deb"
    },
    "publish": null
  }
}
